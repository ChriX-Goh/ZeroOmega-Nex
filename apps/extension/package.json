{
  "name": "@zeroomega-nex/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build:chromium": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@zeroomega-nex/browser-adapters": "workspace:*",
    "@zeroomega-nex/core-contracts": "workspace:*",
    "@zeroomega-nex/profile-spec": "workspace:*",
    "@zeroomega-nex/profile-workflow": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tsconfig/svelte": "5.0.8",
    "@wxt-dev/module-svelte": "2.0.5",
    "svelte": "5.53.7",
    "svelte-check": "4.4.4",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "wxt": "0.20.27"
  }
}
