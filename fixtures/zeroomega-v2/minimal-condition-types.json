{
  "schemaVersion": 2,
  "-startupProfileName": "condition-matrix",
  "-quickSwitchProfiles": ["condition-matrix", "fixed"],
  "+fixed": {
    "name": "fixed",
    "profileType": "FixedProfile",
    "color": "#99ccee",
    "revision": "fixture-condition-target",
    "fallbackProxy": {
      "scheme": "http",
      "host": "proxy.example.invalid",
      "port": 8080
    },
    "bypassList": [
      {
        "conditionType": "BypassCondition",
        "pattern": "<local>"
      }
    ]
  },
  "+condition-matrix": {
    "name": "condition-matrix",
    "profileType": "SwitchProfile",
    "color": "#99dd99",
    "revision": "fixture-condition-matrix",
    "defaultProfileName": "direct",
    "rules": [
      {
        "condition": {
          "conditionType": "FalseCondition",
          "pattern": "disabled fixture rule"
        },
        "profileName": "fixed",
        "note": "FalseCondition"
      },
      {
        "condition": {
          "conditionType": "UrlRegexCondition",
          "pattern": "^https://example\\.invalid/private/"
        },
        "profileName": "fixed",
        "note": "UrlRegexCondition"
      },
      {
        "condition": {
          "conditionType": "UrlWildcardCondition",
          "pattern": "*://*.assets.example.invalid/*|http://legacy.example.invalid/*"
        },
        "profileName": "fixed",
        "note": "UrlWildcardCondition with alternatives"
      },
      {
        "condition": {
          "conditionType": "HostRegexCondition",
          "pattern": "(^|\\.)regex\\.example\\.invalid$"
        },
        "profileName": "fixed",
        "note": "HostRegexCondition"
      },
      {
        "condition": {
          "conditionType": "HostWildcardCondition",
          "pattern": "*.wildcard.example.invalid|**.deep.example.invalid|.leading-dot.example.invalid"
        },
        "profileName": "fixed",
        "note": "HostWildcardCondition legacy wildcard semantics"
      },
      {
        "condition": {
          "conditionType": "BypassCondition",
          "pattern": "https://*.bypass.example.invalid:8443"
        },
        "profileName": "direct",
        "note": "BypassCondition used as an ordinary matcher"
      },
      {
        "condition": {
          "conditionType": "KeywordCondition",
          "pattern": "legacy-keyword"
        },
        "profileName": "fixed",
        "note": "KeywordCondition is HTTP-only upstream"
      },
      {
        "condition": {
          "conditionType": "IpCondition",
          "ip": "192.0.2.0",
          "prefixLength": 24
        },
        "profileName": "fixed",
        "note": "IPv4 IpCondition"
      },
      {
        "condition": {
          "conditionType": "IpCondition",
          "ip": "2001:db8::",
          "prefixLength": 32
        },
        "profileName": "fixed",
        "note": "IPv6 IpCondition"
      },
      {
        "condition": {
          "conditionType": "HostLevelsCondition",
          "minValue": 1,
          "maxValue": 4
        },
        "profileName": "fixed",
        "note": "HostLevelsCondition"
      },
      {
        "condition": {
          "conditionType": "WeekdayCondition",
          "days": "SMTWTFS"
        },
        "profileName": "fixed",
        "note": "WeekdayCondition days representation"
      },
      {
        "condition": {
          "conditionType": "WeekdayCondition",
          "startDay": 1,
          "endDay": 5
        },
        "profileName": "fixed",
        "note": "WeekdayCondition range representation"
      },
      {
        "condition": {
          "conditionType": "TimeCondition",
          "startHour": 9,
          "endHour": 17
        },
        "profileName": "fixed",
        "note": "TimeCondition inclusive local-hour range"
      },
      {
        "condition": {
          "conditionType": "TrueCondition"
        },
        "profileName": "direct",
        "note": "TrueCondition catch-all must remain last"
      }
    ]
  }
}
