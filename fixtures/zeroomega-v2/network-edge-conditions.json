{
  "schemaVersion": 2,
  "+edge proxy": {
    "name": "edge proxy",
    "profileType": "FixedProfile",
    "color": "#6699cc",
    "fallbackProxy": {
      "scheme": "http",
      "host": "proxy.example.invalid",
      "port": 8080
    },
    "proxyForHttps": {
      "scheme": "socks5",
      "host": "2001:db8::10",
      "port": 1080
    },
    "bypassList": [
      {
        "conditionType": "BypassCondition",
        "pattern": "<local>"
      },
      {
        "conditionType": "BypassCondition",
        "pattern": ".example.invalid"
      },
      {
        "conditionType": "BypassCondition",
        "pattern": "https://example.invalid:8443"
      },
      {
        "conditionType": "BypassCondition",
        "pattern": "192.0.2.0/24"
      },
      {
        "conditionType": "BypassCondition",
        "pattern": "2001:db8::/32"
      },
      {
        "conditionType": "BypassCondition",
        "pattern": "[2001:db8::1]"
      },
      {
        "conditionType": "BypassCondition",
        "pattern": "192.0.2.0/not-a-prefix"
      },
      {
        "conditionType": "BypassCondition",
        "pattern": "https://example.invalid:not-a-port"
      },
      {
        "conditionType": "BypassCondition",
        "pattern": "2001:db8::1:443"
      }
    ]
  },
  "+edge switch": {
    "name": "edge switch",
    "profileType": "SwitchProfile",
    "color": "#66cc99",
    "defaultProfileName": "direct",
    "rules": [
      {
        "condition": {
          "conditionType": "HostWildcardCondition",
          "pattern": "例子.测试"
        },
        "profileName": "edge proxy",
        "note": "Unicode IDN source form"
      },
      {
        "condition": {
          "conditionType": "HostWildcardCondition",
          "pattern": "xn--fsqu00a.xn--0zwm56d"
        },
        "profileName": "edge proxy",
        "note": "ASCII IDN source form"
      },
      {
        "condition": {
          "conditionType": "IpCondition",
          "ip": "192.0.2.0",
          "prefixLength": 24
        },
        "profileName": "edge proxy",
        "note": "Documentation IPv4 subnet"
      },
      {
        "condition": {
          "conditionType": "IpCondition",
          "ip": "2001:db8::",
          "prefixLength": 32
        },
        "profileName": "edge proxy",
        "note": "Documentation IPv6 subnet"
      },
      {
        "condition": {
          "conditionType": "IpCondition",
          "ip": "0.0.0.0",
          "prefixLength": 0
        },
        "profileName": "edge proxy",
        "note": "All IPv4 literals"
      },
      {
        "condition": {
          "conditionType": "IpCondition",
          "ip": "::",
          "prefixLength": 0
        },
        "profileName": "edge proxy",
        "note": "All IPv6 literals"
      }
    ]
  },
  "-startupProfileName": "edge switch",
  "-quickSwitchProfiles": ["edge switch", "edge proxy", "direct"]
}
