{
  "schemaVersion": 2,
  "-startupProfileName": "authenticated-proxy",
  "+authenticated-proxy": {
    "name": "authenticated-proxy",
    "profileType": "FixedProfile",
    "color": "#99ccee",
    "revision": "fixture-auth-redacted",
    "fallbackProxy": {
      "scheme": "http",
      "host": "proxy.example.invalid",
      "port": 8080
    },
    "auth": {
      "fallbackProxy": {
        "username": "<redacted>",
        "password": "<redacted>"
      },
      "all": {
        "username": "<redacted>",
        "password": "<redacted>"
      }
    },
    "bypassList": []
  },
  "+header-rule-list": {
    "name": "header-rule-list",
    "profileType": "RuleListProfile",
    "color": "#99dd99",
    "revision": "fixture-headers-redacted",
    "format": "Switchy",
    "sourceUrl": "https://rules.example.invalid/private.txt",
    "matchProfileName": "authenticated-proxy",
    "defaultProfileName": "direct",
    "headers": [
      {
        "name": "X-Fixture-Token",
        "value": "<redacted>"
      },
      {
        "name": "Accept",
        "value": "text/plain"
      },
      {
        "name": "X-Duplicate-Fixture",
        "value": "first"
      },
      {
        "name": "X-Duplicate-Fixture",
        "value": "last"
      },
      {
        "name": "",
        "value": "ignored-by-legacy-fetch-path"
      }
    ],
    "ruleList": "[SwitchyOmega Conditions]\n*.example.invalid\n"
  },
  "+header-pac": {
    "name": "header-pac",
    "profileType": "PacProfile",
    "color": "#00cccc",
    "revision": "fixture-pac-headers-redacted",
    "pacUrl": "https://pac.example.invalid/private.pac",
    "headers": [
      {
        "name": "Authorization",
        "value": "<redacted>"
      }
    ]
  }
}
