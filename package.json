{
  "name": "zeroomega-nex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11.4.0 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @zeroomega-nex/extension dev",
    "dev:firefox": "pnpm --filter @zeroomega-nex/extension dev:firefox",
    "build": "pnpm build:chromium && pnpm build:firefox",
    "build:chromium": "pnpm --filter @zeroomega-nex/extension build:chromium",
    "build:firefox": "pnpm --filter @zeroomega-nex/extension build:firefox",
    "check": "pnpm --filter @zeroomega-nex/core-contracts check && pnpm --filter @zeroomega-nex/profile-spec check && pnpm --filter @zeroomega-nex/legacy-zeroomega check && pnpm --filter @zeroomega-nex/reference-interpreter check && pnpm --filter @zeroomega-nex/pac-compiler check && pnpm --filter @zeroomega-nex/browser-adapters check && pnpm --filter @zeroomega-nex/profile-workflow check && pnpm --filter @zeroomega-nex/extension check",
    "test": "vitest run",
    "test:components": "vitest run --config apps/extension/vitest.component.config.ts",
    "test:e2e": "pnpm test:e2e:chromium && pnpm test:e2e:firefox",
    "test:e2e:chromium": "node scripts/e2e-chromium.mjs",
    "test:e2e:chromium-toolbar": "node scripts/e2e-chromium-toolbar.mjs",
    "test:e2e:chromium-toolbar-restart": "node scripts/e2e-chromium-toolbar-restart.mjs",
    "test:e2e:chromium-attached-rule-list-toolbar": "node scripts/e2e-chromium-attached-rule-list-toolbar.mjs",
    "test:e2e:chromium-profile-traces-toolbar": "node scripts/e2e-chromium-profile-traces-toolbar.mjs",
    "test:e2e:chromium-external-control-toolbar": "node scripts/e2e-chromium-external-control-toolbar.mjs",
    "test:e2e:chromium-renderer-fallback-toolbar": "node scripts/e2e-chromium-renderer-fallback-toolbar.mjs",
    "test:e2e:firefox": "node scripts/e2e-firefox.mjs",
    "test:e2e:firefox-toolbar": "ZEROOMEGA_FIREFOX_TOOLBAR_ONLY=1 node scripts/e2e-firefox.mjs",
    "test:e2e:firefox-toolbar-restart": "node scripts/e2e-firefox-toolbar-restart.mjs",
    "test:e2e:firefox-attached-rule-list-toolbar": "node scripts/e2e-firefox-attached-rule-list-toolbar.mjs",
    "test:e2e:firefox-profile-traces-toolbar": "node scripts/e2e-firefox-profile-traces-toolbar.mjs",
    "test:e2e:firefox-external-control-toolbar": "node scripts/e2e-firefox-external-control-toolbar.mjs",
    "test:e2e:firefox-renderer-fallback-toolbar": "node scripts/e2e-firefox-renderer-fallback-toolbar.mjs",
    "evidence:visual": "node scripts/capture-visual-evidence.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard:architecture": "node scripts/guard-architecture.mjs",
    "validate:ui": "node scripts/validate-ui-compatibility.mjs",
    "validate:parity-docs": "node scripts/validate-parity-docs.mjs",
    "locale:inventory": "node scripts/generate-locale-inventory.mjs --write",
    "validate:locale": "node scripts/generate-locale-inventory.mjs --check && node scripts/validate-localization.mjs",
    "inspect:manifests": "node scripts/inspect-manifests.mjs",
    "stage:builds": "node scripts/stage-builds.mjs",
    "verify": "pnpm guard:architecture && pnpm validate:ui && pnpm validate:parity-docs && pnpm validate:locale && pnpm lint && pnpm format:check && pnpm check && pnpm test && pnpm test:components && pnpm build && pnpm inspect:manifests && pnpm stage:builds",
    "test:e2e:inspect-native": "node scripts/e2e-inspect-native-menu.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "eslint": "10.4.0",
    "eslint-plugin-svelte": "3.15.2",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "4.1.1",
    "selenium-webdriver": "4.46.0",
    "svelte": "5.53.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.7"
  }
}
