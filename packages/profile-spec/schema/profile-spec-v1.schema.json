{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroomega-nex.invalid/schemas/profile-spec-v1.schema.json",
  "title": "ZeroOmega Nex ProfileSpec v1",
  "description": "Stable user-intent configuration. Generated artifacts, runtime state, and secret values are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "revision",
    "profiles",
    "proxyEndpoints",
    "ruleSources",
    "settings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "documentId": {
      "$ref": "#/$defs/identifier"
    },
    "revision": {
      "$ref": "#/$defs/revision"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "proxyEndpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proxyEndpoint"
      }
    },
    "ruleSources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleSource"
      }
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": ["string", "number", "boolean", "null"]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9.-]*/[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "profileType": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": ["string", "number"]
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "parentId": {
          "$ref": "#/$defs/identifier"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "deviceId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "routeTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "direct"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "system"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "profileId"],
          "properties": {
            "kind": {
              "const": "profile"
            },
            "profileId": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "true"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "false"
            },
            "annotation": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern"],
          "properties": {
            "kind": {
              "const": "url-regex"
            },
            "pattern": {
              "type": "string"
            },
            "flags": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern"],
          "properties": {
            "kind": {
              "const": "url-wildcard"
            },
            "pattern": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern"],
          "properties": {
            "kind": {
              "const": "host-regex"
            },
            "pattern": {
              "type": "string"
            },
            "flags": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern"],
          "properties": {
            "kind": {
              "const": "host-wildcard"
            },
            "pattern": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern"],
          "properties": {
            "kind": {
              "const": "bypass"
            },
            "pattern": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern", "httpOnly"],
          "properties": {
            "kind": {
              "const": "keyword"
            },
            "pattern": {
              "type": "string"
            },
            "httpOnly": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "address", "prefixLength"],
          "properties": {
            "kind": {
              "const": "ip"
            },
            "address": {
              "type": "string",
              "minLength": 1
            },
            "prefixLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "min", "max"],
          "properties": {
            "kind": {
              "const": "host-levels"
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "days", "timezone"],
          "properties": {
            "kind": {
              "const": "weekday"
            },
            "days": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": ["sun", "mon", "tue", "wed", "thu", "fri", "sat"]
              }
            },
            "timezone": {
              "const": "local"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "startHour", "endHour", "timezone"],
          "properties": {
            "kind": {
              "const": "time"
            },
            "startHour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "endHour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "timezone": {
              "const": "local"
            }
          }
        }
      ]
    },
    "bypassEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pattern"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "pattern": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "switchRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "route"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "route": {
          "$ref": "#/$defs/routeTarget"
        },
        "note": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "legacy": {
          "$ref": "#/$defs/legacy"
        }
      }
    },
    "profile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "kind", "proxyByScheme", "bypass"],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "enabled": {
              "type": "boolean"
            },
            "legacy": {
              "$ref": "#/$defs/legacy"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            },
            "kind": {
              "const": "fixed"
            },
            "proxyByScheme": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "fallback": {
                  "$ref": "#/$defs/identifier"
                },
                "http": {
                  "$ref": "#/$defs/identifier"
                },
                "https": {
                  "$ref": "#/$defs/identifier"
                },
                "ftp": {
                  "$ref": "#/$defs/identifier"
                }
              }
            },
            "bypass": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/bypassEntry"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "kind", "rules", "defaultRoute"],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "enabled": {
              "type": "boolean"
            },
            "legacy": {
              "$ref": "#/$defs/legacy"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            },
            "kind": {
              "const": "switch"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/switchRule"
              }
            },
            "defaultRoute": {
              "$ref": "#/$defs/routeTarget"
            },
            "attachedRuleListProfileId": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "kind", "sourceId", "matchRoute", "defaultRoute"],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "enabled": {
              "type": "boolean"
            },
            "legacy": {
              "$ref": "#/$defs/legacy"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            },
            "kind": {
              "const": "rule-list"
            },
            "sourceId": {
              "$ref": "#/$defs/identifier"
            },
            "matchRoute": {
              "$ref": "#/$defs/routeTarget"
            },
            "defaultRoute": {
              "$ref": "#/$defs/routeTarget"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "kind", "source"],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "enabled": {
              "type": "boolean"
            },
            "legacy": {
              "$ref": "#/$defs/legacy"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            },
            "kind": {
              "const": "pac"
            },
            "source": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "script"],
                  "properties": {
                    "kind": {
                      "const": "inline"
                    },
                    "script": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "url"],
                  "properties": {
                    "kind": {
                      "const": "url"
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "script": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "fallbackRoute": {
              "$ref": "#/$defs/routeTarget"
            },
            "headers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ruleSourceHeader"
              }
            },
            "credential": {
              "type": "object",
              "additionalProperties": false,
              "required": ["passwordSecretRef"],
              "properties": {
                "username": {
                  "type": "string"
                },
                "passwordSecretRef": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "kind"],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "enabled": {
              "type": "boolean"
            },
            "legacy": {
              "$ref": "#/$defs/legacy"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            },
            "kind": {
              "const": "auto-detect"
            },
            "fallbackRoute": {
              "$ref": "#/$defs/routeTarget"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "kind", "targetRoute"],
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "enabled": {
              "type": "boolean"
            },
            "legacy": {
              "$ref": "#/$defs/legacy"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            },
            "kind": {
              "const": "virtual"
            },
            "targetRoute": {
              "$ref": "#/$defs/routeTarget"
            }
          }
        }
      ]
    },
    "proxyEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "protocol", "host", "port"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "protocol": {
          "enum": ["http", "https", "socks4", "socks5"]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "credential": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passwordSecretRef"],
          "properties": {
            "username": {
              "type": "string"
            },
            "passwordSecretRef": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "headerValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "secretRef"],
          "properties": {
            "kind": {
              "const": "secret"
            },
            "secretRef": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "ruleSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "format", "location"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": ["autoproxy", "switchy"]
        },
        "location": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "content"],
              "properties": {
                "kind": {
                  "const": "inline"
                },
                "content": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "url"],
              "properties": {
                "kind": {
                  "const": "url"
                },
                "url": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleSourceHeader"
          }
        },
        "updateIntervalMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "builtInAppearance": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "direct": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "color": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "system": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "color": {
              "$ref": "#/$defs/color"
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "quickSwitch", "interface", "ruleSourceUpdateIntervalMinutes"],
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revertProxyChanges"],
          "properties": {
            "route": {
              "$ref": "#/$defs/routeTarget"
            },
            "revertProxyChanges": {
              "type": "boolean"
            }
          }
        },
        "quickSwitch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "routes", "refreshOnChange"],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "refreshOnChange": {
              "type": "boolean"
            },
            "routes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/routeTarget"
              }
            }
          }
        },
        "interface": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "confirmDeletion",
            "showInspectMenu",
            "addConditionsToBottom",
            "showResultProfileOnActionBadgeText",
            "showExternalProfile",
            "showAdvancedConditions",
            "exportLegacyRuleList"
          ],
          "properties": {
            "confirmDeletion": {
              "type": "boolean"
            },
            "showInspectMenu": {
              "type": "boolean"
            },
            "monitorWebRequests": {
              "type": "boolean"
            },
            "addConditionsToBottom": {
              "type": "boolean"
            },
            "showResultProfileOnActionBadgeText": {
              "type": "boolean"
            },
            "showExternalProfile": {
              "type": "boolean"
            },
            "showAdvancedConditions": {
              "type": "boolean"
            },
            "exportLegacyRuleList": {
              "type": "boolean"
            },
            "builtInProfiles": {
              "$ref": "#/$defs/builtInAppearance"
            }
          }
        },
        "ruleSourceUpdateIntervalMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "sync": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend"],
          "properties": {
            "backend": {
              "enum": ["none", "browser", "gist", "webdav"]
            },
            "remoteUri": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "secretRef": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },
    "ruleSourceHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/headerValue"
        }
      }
    }
  }
}
